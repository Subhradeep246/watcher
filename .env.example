# ── TheWatcher environment ─────────────────────────────────────────────
# Copy this file to `.env` (in the backend/ folder or project root) and fill in.
# Only NVIDIA_API_KEY is needed for live inference. Everything else degrades gracefully.

# ---- Provider selection ----------------------------------------------
# auto = first configured host. Primary: nvidia | coreweave
# Comparison: wandb | none
PRIMARY_PROVIDER=auto
SECONDARY_PROVIDER=auto

# ---- NVIDIA NIM : primary vision model (REQUIRED for live inference) --
# Free key at https://build.nvidia.com  (OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# ---- CoreWeave : self-hosted Gemma on your own GPU (OPTIONAL) ---------
# See deploy/coreweave/gemma-gpu.yaml. Set PRIMARY_PROVIDER=coreweave to use it.
COREWEAVE_BASE_URL=
COREWEAVE_API_KEY=
COREWEAVE_MODEL=google/gemma-4-31B-it

# ---- Weights & Biases : comparison model + Weave tracing (OPTIONAL) ---
# Key at https://wandb.ai/authorize. W&B Inference runs on CoreWeave GPUs.
# WANDB_PROJECT=<entity>/<project> enables Weave traces of every agent call.
WANDB_API_KEY=
WANDB_PROJECT=
WANDB_INFERENCE_MODEL=google/gemma-4-31B-it

# ---- 511NY (NYC cameras + alerts) : OPTIONAL -------------------------
# Without this key the app uses bundled sample camera data (backend/app/data).
NY511_API_KEY=

# ---- NYC Open Data (Socrata) : OPTIONAL ------------------------------
SOCRATA_APP_TOKEN=

# ---- Map tiles : OPTIONAL --------------------------------------------
# Frontend uses CARTO dark basemaps; they need a key (carto.com/basemaps/apikey)
# or tiles show an "API KEY REQUIRED" watermark. Put VITE_* vars in frontend/.env.local.
VITE_CARTO_KEY=
# Optional: switch to Geoapify tiles instead.
VITE_GEOAPIFY_KEY=

# ---- Backend server ---------------------------------------------------
WATCHER_HOST=127.0.0.1
WATCHER_PORT=8000
# Comma-separated origins allowed to call the API (the Vite dev server).
WATCHER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
