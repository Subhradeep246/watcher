# Copy to .env in the project root or backend/. Never commit credentials.
PRIMARY_PROVIDER=auto
SECONDARY_PROVIDER=auto

# Hosted NVIDIA vision inference
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_DISABLE_THINKING=true
# Used on the last attempt after two HTTP 503 overload responses. Empty disables it.
NVIDIA_FALLBACK_MODEL=meta/llama-3.2-11b-vision-instruct

# Optional dedicated CoreWeave vision endpoint; deploy/coreweave/vision-gpu.yaml
COREWEAVE_BASE_URL=
COREWEAVE_API_KEY=
COREWEAVE_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# W&B Inference on CoreWeave GPUs + Weave traces
WANDB_API_KEY=
WANDB_PROJECT=
WANDB_INFERENCE_MODEL=meta-llama/Llama-3.1-8B-Instruct
WANDB_VISION_ENABLED=false
WEAVE_ENABLED=true

# Optional TypeSafe text consistency review on full Scan (separate service/key)
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Optional incident data (without keys context is explicitly marked sample)
NY511_API_KEY=
SOCRATA_APP_TOKEN=
VITE_GEOAPIFY_KEY=
WATCHER_HOST=127.0.0.1
WATCHER_PORT=8000
WATCHER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
